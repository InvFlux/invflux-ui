node_modules/

dist/
build/
# `build/` is unanchored, so it matches at any depth — including packages/build, which is the
# shared Vite-config package (source, not output). Without this it is silently invisible to git.
!packages/build/
coverage/
test-results/
# The adapter runs wp-env with `WP_ENV_HOME=.wp-env-home`, which is relative — so a wp-env command
# issued from anywhere in this repo drops a home here instead. Nothing in it is ours; it is a
# per-project state cache wp-env rebuilds on demand.
.wp-env-home/

*.local
